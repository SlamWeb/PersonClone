# Copy this file to .env and fill only the providers you use.

PERSONAFORGE_LLM_PROVIDER=deepseek
PERSONAFORGE_QUERY_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Optional local paths
PERSONAFORGE_DATA_DIR=data
PERSONAFORGE_EMBEDDING_MODEL=BAAI/bge-m3

# Docker Compose only. Use a named volume by default, or set an absolute host
# cache path such as D:/PersonaForgeCache to reuse an existing BGE-M3 download.
PERSONAFORGE_DOCKER_MODEL_SOURCE=personaforge-models
PERSONAFORGE_PORT=8000
