        <mxCell id="metrics" value="回看每条路自己的 Top3&lt;br&gt;Hit@3 · MRR@3 · nDCG@3 · Precision@3&lt;br&gt;未来应新增 raw_hybrid_rrf：原问题 Dense+Sparse RRF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6B8FC2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="940" width="500" height="100" as="geometry"/>
