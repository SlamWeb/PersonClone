<mxfile host="app.diagrams.net" modified="2026-08-08T00:00:00.000Z" agent="PersonaForge" version="24.7.17">
  <diagram id="rag-pipeline" name="RAG链路">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="PersonaForge：从用户问题到 RAG 材料的完整链路" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#17212B;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="input" value="用户问题 + 会话上下文&lt;br&gt;例如：为什么大家嘲笑力工？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6B8FC2;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="250" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="planner" value="Turn Planner&lt;br&gt;补全追问、确定独立问题&lt;br&gt;resolved_question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#8995A1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="mode" value="查询模式&lt;br&gt;raw / grounded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C8A55A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="110" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="searchplanner" value="Grounded：Search Planner&lt;br&gt;LLM 调用 1&lt;br&gt;只判断是否联网，最多 3 个 Tavily 搜索词" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#659A72;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="900" y="90" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="tavily" value="需要联网时&lt;br&gt;Tavily 搜索最多 3 个词&lt;br&gt;得到词义、热点或事件背景" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#659A72;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1260" y="90" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="transform" value="Background + Query Transform&lt;br&gt;LLM 调用 2&lt;br&gt;固定输出 4 个本地检索变体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEAEA;strokeColor=#B86B6B;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="240" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="variants" value="4 个变体&lt;br&gt;literal_question&lt;br&gt;event_background&lt;br&gt;mechanism_scene&lt;br&gt;colloquial_surface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEAEA;strokeColor=#B86B6B;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1260" y="235" width="280" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="rawbranch" value="原问题 raw 路由&lt;br&gt;生产 Chat 的 raw 模式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6B8FC2;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="250" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="rawdetail" value="原问题&lt;br&gt;BGE-M3 dense child Top100&lt;br&gt;BGE-M3 sparse child Top100&lt;br&gt;parent 折叠 → Dense+Sparse RRF → parent Top20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6B8FC2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="330" y="410" width="330" height="115" as="geometry"/>
        </mxCell>

        <mxCell id="variantbranch" value="Query Transform 路由&lt;br&gt;默认 grounded Chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEAEA;strokeColor=#B86B6B;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="430" width="250" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="variantdetail" value="4 个变体分别执行：&lt;br&gt;每个变体 → dense child Top100 + sparse child Top100&lt;br&gt;→ 该变体内部 parent RRF Top30&lt;br&gt;→ 跨 4 个变体 parent RRF → 最终 parent Top20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEAEA;strokeColor=#B86B6B;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1010" y="400" width="380" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="bm25branch" value="BM25 词法基线&lt;br&gt;不属于默认 Chat 主链路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C8A55A;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="250" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="bm25detail" value="原问题&lt;br&gt;jieba.cut_for_search&lt;br&gt;BM25 child Top100 → parent 折叠 → parent Top30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C8A55A;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="330" y="585" width="330" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="writer" value="Writer 最终上下文&lt;br&gt;当前问题 + objective_background&lt;br&gt;+ 最终 parent Top20 全文&lt;br&gt;+ 会话摘要、最近三轮、用户记忆" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#659A72;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="610" width="330" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="answer" value="Writer LLM&lt;br&gt;生成最终回答 + 引用材料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#659A72;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1130" y="630" width="260" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="evaltitle" value="RAG 评估链路：诊断路由，不等于生产上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#8995A1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="360" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="routes" value="当前四路候选 Top30&lt;br&gt;① raw_dense：原问题 Dense&lt;br&gt;② raw_sparse：原问题 Sparse&lt;br&gt;③ transformed_rrf：4 变体两层 RRF&lt;br&gt;④ raw_bm25：原问题 BM25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F5F7;strokeColor=#8995A1;fontSize=14;" vertex="1" parent="1">
