        </mxCell>
        <mxCell id="union" value="按 parent_id 合并去重&lt;br&gt;得到每题候选池&lt;br&gt;739 = 10 题的 query-parent 对总数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C8A55A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="790" width="290" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="labels" value="LLM / 人工逐个标注&lt;br&gt;0 无用 · 1 有一定帮助 · 2 明显有用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#C8A55A;fontSize=15;" vertex="1" parent="1">
